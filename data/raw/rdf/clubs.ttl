vres:Câu_lạc_bộ_bóng_đá_Quy_Nhơn_United a vio:FootballClub ;
    rdfs:label "Quy Nhon United FC"@en,
        "Câu lạc bộ bóng đá Quy Nhơn United"@vi ;
    dbo:abstract "Câu lạc bộ bóng đá Quy Nhơn United (tiếng Anh: Quy Nhon United Football Club), hay còn được biết đến với tên cũ trước sáp nhập là Câu lạc bộ bóng đá Bình Định, là một câu lạc bộ bóng đá chuyên nghiệp Việt Nam có trụ sở tại phường Quy Nhơn, tỉnh Gia Lai. Đội bóng hiện đang thi đấu ở Giải hạng Nhất Quốc gia, giải đấu cao thứ hai trong hệ thống giải đấu bóng đá Việt Nam. Sân nhà của đội là sân vận động Quy Nhơn (tỉnh Gia Lai) có sức chứa 20.000 người."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/vi/thumb/6/66/Logo_CLB_Quy_Nh%C6%A1n_United.png/330px-Logo_CLB_Quy_Nh%C6%A1n_United.png> ;

vres:Câu_lạc_bộ_bóng_đá_Cần_Thơ a vio:FootballClub ;
    rdfs:label "Can Tho FC"@en,
        "Câu lạc bộ bóng đá Cần Thơ"@vi ;
    dbo:abstract "Câu lạc bộ bóng đá Cần Thơ, thường được gọi ngắn gọn là Cần Thơ, từng là một câu lạc bộ bóng đá có trụ sở tại thành phố Cần Thơ, Việt Nam. Đội bóng có biệt danh là \"Tây Đô\" và thi đấu các trận sân nhà tại Sân vận động Cần Thơ. Hiện tại, câu lạc bộ đã giải thể sau khi không đăng ký tham gia bất kỳ Giải đấu chuyên nghiệp nào kể từ mùa giải 2025."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/vi/thumb/8/82/C%E1%BA%A7n_Th%C6%A1_FC_2022.svg/330px-C%E1%BA%A7n_Th%C6%A1_FC_2022.svg.png> ;

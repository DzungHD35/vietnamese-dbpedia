vres:Trung_tâm_đào_tạo_bóng_đá_trẻ_PVF a vio:FootballClub ;
    rdfs:label "PVF Football Academy"@en,
        "Trung tâm đào tạo bóng đá trẻ PVF"@vi ;
    dbo:abstract """Học viện bóng đá Quỹ Đầu tư và Phát triển Tài năng Bóng đá Việt Nam (PVF), hiện được gọi là Trung tâm Đào tạo Bóng đá trẻ PVF – Bộ Công an, là một học viện bóng đá tư nhân có trụ sở tại Hưng Yên, Việt Nam. Cơ sở này hiện thuộc quyền quản lý chính thức của Bộ Công an Việt Nam. PVF hiện đang thi đấu tại Giải bóng đá Hạng Nhì Quốc gia, giải đấu cấp độ thứ ba trong hệ thống giải đấu bóng đá Việt Nam.
Tính đến năm 2020, PVF đã được Liên đoàn bóng đá châu Á (AFC) công nhận là học viện ba sao theo Chương trình Học viện trẻ xuất sắc AFC, trở thành học viện bóng đá đầu tiên tại Đông Nam Á đạt được vị thế này."""@vi ;

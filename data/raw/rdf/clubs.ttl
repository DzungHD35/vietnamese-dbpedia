vres:Câu_lạc_bộ_bóng_đá_Bình_Minh_Sài_Gòn a vio:FootballClub ;
    rdfs:label "Aurora Saigon United FC"@en,
        "Câu lạc bộ bóng đá Bình Minh Sài Gòn"@vi ;
    dbo:abstract """Câu lạc bộ bóng đá Bình Minh Sài Gòn (tiếng Anh: Aurora Saigon United) là một câu lạc bộ bóng đá chuyên nghiệp Việt Nam có trụ sở tại Thành phố Hồ Chí Minh, hiện thi đấu tại Giải hạng Nhất Quốc gia. Tiền thân của đội là Đội bóng đá Đồng Tháp, thành lập năm 1976 do Sở Thể dục Thể thao tỉnh Đồng Tháp quản lý.
Trong 50 năm mang tên Đồng Tháp, đội là một trong những thế lực tiêu biểu của bóng đá Đồng bằng sông Cửu Long, từng hai lần vô địch quốc gia vào các năm 1989 và 1996, trong đó năm 1989 là chức vô địch đầu tiên của một đội bóng vừa thăng hạng từ giải hạng dưới. Đội cũng từng được xem là một trong những trung tâm đào tạo trẻ mạnh nhất cả nước, sản sinh nhiều tuyển thủ quốc gia như Trần Công Minh, Phan Thanh Bình và Bùi Tấn Trường.
Tháng 8 năm 2026, sau khi không còn được thuê Sân vận động Cao Lãnh và phải bàn giao trụ sở về Sở Văn hóa, Thể thao và Du lịch tỉnh Đồng Tháp, câu lạc bộ chuyển trụ sở lên Thành phố Hồ Chí Minh và đổi tên thành Bình Minh Sài Gòn cho mùa giải 2026–27."""@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/vi/thumb/3/3b/Logo_CLB_B%C3%ACnh_Minh_S%C3%A0i_G%C3%B2n.png/330px-Logo_CLB_B%C3%ACnh_Minh_S%C3%A0i_G%C3%B2n.png> ;
    dbo:wikiPageExternalLink <https://hunghau.vn/vi/featured_item/clb-bong-da-dong-thap/>,
        <https://vpf.vn/team/dong-thap/> ;

vres:Sân_vận_động_Gò_Đậu a vio:Stadium ;
    rdfs:label "Gò Đậu Stadium"@en,
        "Sân vận động Gò Đậu"@vi ;
    dbo:abstract "Sân vận động Bình Dương, tên thường gọi là Sân vận động Gò Đậu, là một sân vận động đa năng ở phường Thủ Dầu Một, Thành phố Hồ Chí Minh, Việt Nam. Nằm trong khuôn viên có diện tích hơn 4 ha tại góc đường 30 Tháng 4 và Đại lộ Bình Dương, sân vận động có 4 khán đài với sức chứa khoảng 18.250 chỗ ngồi. Đây là sân nhà của câu lạc bộ Becamex Thành phố Hồ Chí Minh hiện đang thi đấu tại V.League 2."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/B%C3%ACnh_D%C6%B0%C6%A1ng_Stadium_2023.jpg/330px-B%C3%ACnh_D%C6%B0%C6%A1ng_Stadium_2023.jpg> ;

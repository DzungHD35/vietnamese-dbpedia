vres:Phạm_Quỳnh_Anh_\(cầu_thủ_bóng_đá\) a vio:FootballPlayer ;
    rdfs:label "Phạm Quỳnh Anh (cầu thủ bóng đá)"@vi ;
    dbo:abstract """Phạm Quỳnh Anh là một cầu thủ bóng đá người Việt Nam từng chơi ở vị trí tiền vệ cho Đội tuyển bóng đá nữ quốc gia Việt Nam.
Phạm Quỳnh Anh từng được triệu tập vào danh sách đội tuyển nữ Việt Nam tham dự Đại hội Thể thao Đông Nam Á 2003, giải đấu mà cô ghi được một bàn thắng từ cú đá phạt vào lưới Philippines."""@vi ;
    dbo:wikiPageID 19965225 ;
    dbo:wikiPageLength "2205"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 74652934 ;

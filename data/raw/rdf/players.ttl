vres:Mai_Duy_Dưỡng a vio:FootballPlayer ;
    rdfs:label "Mai Duy Dưỡng"@vi ;
    dbo:abstract """Mai Duy Dưỡng (1918 - 2016) là một cầu thủ bóng đá, tuyển thủ bóng bàn đã từng vô địch Đông Dương ở cả hai môn bóng bàn và bóng đá.
Ông sinh ra tại Nam Định trong một gia đình khá giả có tiếng.
Thuở nhỏ, ông là bạn học thân thiết với nhà văn Nguyên Hồng, đánh bi đánh đáo rất giỏi, đặc biệt là đá bóng bằng trái bưởi, cuộn giẻ, quả bóng quần trơ lõi."""@vi ;
    dbo:wikiPageID 778759 ;
    dbo:wikiPageLength "2672"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75378291 ;
    dct:subject vcat:Cầu_thủ_bóng_đá_nam_Việt_Nam,
        vcat:Người_Nam_Định,
        vcat:Sinh_năm_1918,
        vcat:Sơ_khai_cầu_thủ_bóng_đá_Việt_Nam,
        vcat:Vận_động_viên_bóng_bàn_Việt_Nam ;
    vio:birthYear "1918"^^xsd:gYear ;
    rdfs:comment "Mai Duy Dưỡng (1918 - 2016) là một cầu thủ bóng đá, tuyển thủ bóng bàn đã từng vô địch Đông Dương ở cả hai môn bóng bàn và bóng đá."@vi ;

vres:Đỗ_Duy_Mạnh a vio:FootballPlayer ;
    rdfs:label "Đỗ Duy Mạnh"@en,
        "Đỗ Duy Mạnh"@vi ;
    dbo:abstract "Đỗ Duy Mạnh (sinh ngày 29 tháng 9 năm 1996) là một cầu thủ bóng đá chuyên nghiệp người Việt Nam hiện đang thi đấu ở vị trí trung vệ cho câu lạc bộ V.League 1 Hà Nội và là đội trưởng của đội tuyển bóng đá quốc gia Việt Nam. Anh nổi tiếng nhờ khả năng đọc trận đấu tốt và khả năng phát động tấn công từ tuyến dưới bằng những đường chuyền dài vượt tuyến chính xác."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/%C4%90%E1%BB%97_Duy_M%E1%BA%A1nh_20191201_%28cropped%29.jpg/330px-%C4%90%E1%BB%97_Duy_M%E1%BA%A1nh_20191201_%28cropped%29.jpg> ;

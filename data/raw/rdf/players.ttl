vres:Bùi_Quang_Vinh a vio:FootballPlayer ;
    rdfs:label "Bùi Quang Vinh"@en,
        "Bùi Quang Vinh"@vi ;
    dbo:abstract "Bùi Quang Vinh (sinh năm 1953) là một chính khách Việt Nam. Ông nguyên là Ủy viên Ban Chấp hành Trung ương Đảng Cộng sản Việt Nam khóa X, XI, Bộ trưởng Bộ Kế hoạch và Đầu tư Việt Nam (2011-2016),Đại biểu Quốc hội Việt Nam khóa XIII tỉnh Lai Châu. Trong vai trò Bộ trưởng Kế hoạch Đầu tư, ông Bùi Quang Vinh được cho là người giám sát và tham gia soạn thảo đề án đặc khu hành chính - kinh tế Vân Đồn, Bắc Vân Phong, Phú Quốc."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Mr._Bui_Quang_Vinh.jpg/330px-Mr._Bui_Quang_Vinh.jpg> ;
    dbo:wikiPageExternalLink <http://vids.mpi.gov.vn/vietnam2035/12/39.html>,
        <http://vietnamnet.vn/vn/chinh-tri/157792/dia-phuong-chay-chot-the-nao-bo-truong-biet-het.html>,
        <https://web.archive.org/web/20181113000501/http://vids.mpi.gov.vn/vietnam2035/12/39.html> ;
    dbo:wikiPageID 626284 ;
    dbo:wikiPageLength "18297"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75443253 ;
    dct:subject vcat:Bí_thư_Tỉnh_ủy_Lào_Cai,
        vcat:Bộ_trưởng_Bộ_Kế_hoạch_và_Đầu_tư_Việt_Nam,
        vcat:Chủ_tịch_Ủy_ban_nhân_dân_tỉnh_Lào_Cai,
        vcat:Cựu_sinh_viên_trường_Đại_học_Nông_nghiệp_Hà_Nội,
        vcat:Người_Hà_Nội,

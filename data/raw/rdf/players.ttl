vres:Lê_Sỹ_Mạnh a vio:FootballPlayer ;
    rdfs:label "Lê Sỹ Mạnh"@en,
        "Lê Sỹ Mạnh"@vi ;
    dbo:abstract """Lê Sỹ Mạnh (sinh ngày 2 tháng 12 năm 1984) là một cựu cầu thủ bóng đá người Việt Nam. Thời còn thi đấu, anh chơi ở vị trí tiền đạo cho nhiều câu lạc bộ như T&T Hà Nội, The Vissai Ninh Bình, Thanh Hóa, Hải Phòng,...
Sỹ Mạnh cũng từng là thành viên của đội tuyển bóng đá quốc gia Việt Nam dưới thời huấn luyện viên Henrique Calisto."""@vi ;
    dbo:wikiPageID 19803135 ;
    dbo:wikiPageLength "13390"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 74912241 ;

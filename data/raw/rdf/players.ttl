vres:Trần_Văn_Kiên a vio:FootballPlayer ;
    rdfs:label "Trần Văn Kiên"@en,
        "Trần Văn Kiên"@vi ;
    dbo:abstract """Trần Văn Kiên (sinh ngày 13 tháng 5 năm 1996, quê tại Nghĩa Đàn, Nghệ An) là một cầu thủ bóng đá chuyên nghiệp người Việt Nam hiện đang thi đấu cho câu lạc bộ Thép Xanh Nam Định ở vị trí hậu vệ cánh phải. Anh trưởng thành tại lò đào tạo của câu lạc bộ Hà Nội và đã từng được gọi lên đội tuyển quốc gia Việt Nam.
Anh hiện đang giữ kỷ lục về số lần vô địch V-League với 6 lần (2016, 2018, 2019, 2022, 2023–24 và 2024–25)."""@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Van_Kien.png/330px-Van_Kien.png> ;
    dbo:wikiPageID 13504595 ;
    dbo:wikiPageLength "8118"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75485043 ;

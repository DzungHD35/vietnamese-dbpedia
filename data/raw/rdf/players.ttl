vres:Phạm_Huỳnh_Tam_Lang a vio:FootballPlayer ;
    rdfs:label "Phạm Huỳnh Tam Lang"@en,
        "Phạm Huỳnh Tam Lang"@vi ;
    dbo:abstract "Phạm Huỳnh Tam Lang (14 tháng 2 năm 1942 – 2 tháng 6 năm 2014) là một cựu cầu thủ bóng đá chuyên nghiệp người Việt Nam. Ông từng thi đấu cho Đội tuyển bóng đá quốc gia Việt Nam Cộng hòa và từng là huấn luyện viên trưởng Câu lạc bộ bóng đá Cảng Sài Gòn và Đội tuyển bóng đá quốc gia Việt Nam. Ông được coi là một trong những trung vệ xuất sắc trong lịch sử bóng đá Việt Nam và châu Á."@vi ;
    dbo:thumbnail <https://upload.wikimedia.org/wikipedia/vi/a/a8/Ph%E1%BA%A1m_Hu%E1%BB%B3nh_Tam_Lang.jpg> ;
    dbo:wikiPageExternalLink <http://giaoduc.net.vn/The-thao/Bong-da-VN/Di-tim-cau-thu-xuat-sac-nhat-Viet-Nam-Hong-Son-thua-xa-Ba-Den-Ky-1/5753.gd>,
        <http://thethao.tuoitre.vn/tin/2014/06/02/bong-da/cuu-danh-thu-pham-huynh-tam-lang-qua-doi/49717.html>,
        <https://web.archive.org/web/20140603044214/http://thethao.tuoitre.vn/tin/2014/06/02/bong-da/cuu-danh-thu-pham-huynh-tam-lang-qua-doi/49717.html> ;
    dbo:wikiPageID 125309 ;
    dbo:wikiPageLength "12433"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75376001 ;

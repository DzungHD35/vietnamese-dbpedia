vres:Phạm_Thị_Lan_Anh_\(cầu_thủ_bóng_đá\) a vio:FootballPlayer ;
    rdfs:label "Phạm Thị Lan Anh (cầu thủ bóng đá)"@vi ;
    dbo:abstract """Phạm Thị Lan Anh (sinh 4 tháng 1 năm 2001) là một cầu thủ bóng đá người Việt Nam chơi ở vị trí hậu vệ cho câu lạc bộ Hà Nội I và Đội tuyển bóng đá nữ quốc gia Việt Nam.
Lan Anh lần đầu được triệu tập lên đội tuyển quốc gia vào năm 2022 để tham dự Giải vô địch bóng đá nữ Đông Nam Á 2022."""@vi ;

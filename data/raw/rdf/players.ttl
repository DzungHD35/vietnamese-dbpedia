vres:Hoàng_Văn_Bình_\(cầu_thủ_bóng_đá\) a vio:FootballPlayer ;
    rdfs:label "Hoàng Văn Bình"@en,
        "Hoàng Văn Bình (cầu thủ bóng đá)"@vi ;
    dbo:abstract "Hoàng Văn Bình (sinh ngày 1 tháng 2 năm 1989) là cựu cầu thủ bóng đá chuyên nghiệp thi đấu ở vị trí tiền vệ và từng là tuyển thủ đội tuyển bóng đá quốc gia Việt Nam. Sau khi giải nghệ, anh chuyển sang làm công tác huấn luyện cho đội U-11 Sông Lam Nghệ An và có bằng huấn luyện hạng C do Liên đoàn bóng đá Việt Nam VFF-AFC tổ chức."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Ho%C3%A0ng_V%C4%83n_B%C3%ACnh_2019.jpg/330px-Ho%C3%A0ng_V%C4%83n_B%C3%ACnh_2019.jpg> ;

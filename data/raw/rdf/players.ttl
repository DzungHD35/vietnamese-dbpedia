vres:Dương_Hồng_Sơn a vio:FootballPlayer ;
    rdfs:label "Dương Hồng Sơn"@en,
        "Dương Hồng Sơn"@vi ;
    dbo:abstract """Dương Hồng Sơn (sinh ngày 20 tháng 11 năm 1982) là một cựu cầu thủ bóng đá chơi ở vị trí thủ môn. Hiện nay, anh đang làm huấn luyện viên của đội Trẻ Hà Nội.
Là chủ nhân Quả bóng vàng Việt Nam năm 2008, anh được đánh giá là một trong những thủ môn xuất sắc nhất lịch sử bóng đá Việt Nam.
Anh là một trong những thủ môn xuất sắc nhất lịch sử bóng đá Việt Nam, từng đạt bốn giải găng tay vàng vào 4 năm liên tiếp 2010–2014. Với 300 trận đã đấu, anh giữ sạch lưới đến 180 trận. Tại giải vô địch bóng đá Đông Nam Á 2008, Dương Hồng Sơn đã thi đấu rất xuất sắc và là một trong những cầu thủ quan trọng giúp cho đội tuyển Việt Nam lần đầu tiên đoạt cúp vô địch, anh cũng đoạt được danh hiệu "Cầu thủ xuất sắc nhất" tại giải này."""@vi ;
    dbo:thumbnail <https://upload.wikimedia.org/wikipedia/commons/8/8a/Duong_Hong_Son_2008.jpg> ;
    dbo:wikiPageExternalLink <https://web.archive.org/web/20081230200522/http://www.vff.org.vn/default.aspx?mod=DetailNews&fNewsID=10282&fCatID=140&fSncID=&fMscID=> ;
    dbo:wikiPageID 315224 ;
    dbo:wikiPageLength "13636"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75485463 ;

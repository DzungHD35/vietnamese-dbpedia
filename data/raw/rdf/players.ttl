vres:Lê_Văn_Xuân_\(cầu_thủ_bóng_đá\) a vio:FootballPlayer ;
    rdfs:label "Lê Văn Xuân"@en,
        "Lê Văn Xuân (cầu thủ bóng đá)"@vi ;
    dbo:abstract """Lê Văn Xuân (sinh ngày 27 tháng 2 năm 1999) là một cầu thủ bóng đá chuyên nghiệp người Việt Nam hiện đang thi đấu ở vị trí hậu vệ cánh cho Bắc Ninh tại giải bóng đá vô địch quốc gia V-League 1 và Đội tuyển quốc gia Việt Nam.
Văn Xuân là sản phẩm của lò đào tạo bóng đá trẻ PVF (khoá 2). Anh từng được gọi lên đội tuyển U-22 Việt Nam vào năm 2019."""@vi ;
    dbo:wikiPageID 19475995 ;
    dbo:wikiPageLength "5429"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75457041 ;

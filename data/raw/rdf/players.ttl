vres:Võ_Nhật_Tân a vio:FootballPlayer ;
    rdfs:label "Võ Nhật Tân"@en,
        "Võ Nhật Tân"@vi ;
    dbo:abstract "Võ Nhật Tân (sinh ngày 2 tháng 5 năm 1988 tại Gò Công Tây, Tiền Giang) là một cầu thủ bóng đá người Việt Nam, khoác áo câu lạc bộ Đồng Tháp. Cùng với Nguyễn Thành Long Giang, Huỳnh Phúc Hiệp...anh đã góp công lớn giúp Tiền Giang vô địch giải U-21 Quốc gia năm 2006. Nhờ thi đấu thành công ở giải này Nhật Tân có tên trong thành phần đội tuyển U23 Việt Nam tham dự vòng loại Olympic Bắc Kinh 2008 và SEA Games 24. Năm 2010 sau khi đội Tiền Giang xuống hạng Nhì anh chuyển sang thi đấu cho đội Đồng Tâm Long An."@vi ;
    dbo:wikiPageID 3282529 ;
    dbo:wikiPageLength "1760"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 74144855 ;
    dct:subject vcat:Cầu_thủ_bóng_đá_nam_Việt_Nam,
        vcat:Cầu_thủ_câu_lạc_bộ_bóng_đá_Long_An,
        vcat:Cầu_thủ_câu_lạc_bộ_bóng_đá_Tiền_Giang,
        vcat:Cầu_thủ_đội_tuyển_bóng_đá_U-23_quốc_gia_Việt_Nam,
        vcat:Người_Tiền_Giang,
        vcat:Nhân_vật_còn_sống,
        vcat:Sinh_năm_1988,
        vcat:Sơ_khai_cầu_thủ_bóng_đá_Việt_Nam ;
    vio:birthDate "1987-06-27"^^xsd:date ;
    vio:birthPlace vres:Gò_Công_Tây ;
    vio:birthProvince vres:Tiền_Giang ;
    vio:careerStation vres:Võ_Nhật_Tân__1 ;
    vio:position vres:Hậu_vệ_\(bóng_đá\) ;
    rdfs:comment "Võ Nhật Tân (sinh ngày 2 tháng 5 năm 1988 tại Gò Công Tây, Tiền Giang) là một cầu thủ bóng đá người Việt Nam, khoác áo câu lạc bộ Đồng Tháp. Cùng với Nguyễn Thành Long Giang, Huỳnh Phúc Hiệp...anh đã góp công lớn giúp Tiền Giang vô địch giải U-21 Quốc gia năm 2006."@vi ;

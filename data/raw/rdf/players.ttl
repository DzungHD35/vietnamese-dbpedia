        vcat:Người_Mường,
        vcat:Người_Thanh_Hóa,
        vcat:Người_huyện_Bá_Thước,
        vcat:Sinh_năm_2007,
        vcat:Tiền_vệ_bóng_đá,
        vcat:Tiền_đạo_bóng_đá ;
    vio:birthDate "2007-02-13"^^xsd:date ;

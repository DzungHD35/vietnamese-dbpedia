vres:Đỗ_Thị_Phương a vio:FootballPlayer ;
    rdfs:label "Đỗ Thị Phương"@vi ;
    dbo:abstract """Đỗ Thị Phương là một cầu thủ bóng đá người Việt Nam từng chơi ở vị trí tiền đạo cho câu lạc bộ Hà Tây và Đội tuyển bóng đá nữ quốc gia Việt Nam.
Đỗ Thị Phương từng ghi được một bàn thắng tại Đại hội Thể thao Đông Nam Á 2003 trong chiến thắng 3–0 của Việt Nam trước Philippines."""@vi ;

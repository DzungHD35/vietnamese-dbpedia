<http://vi.dbpedia.org/resource/Nguyễn_Văn_Dũng_(cầu_thủ_bóng_đá,_sinh_1963)> a vio:FootballPlayer ;
    rdfs:label "Nguyễn Văn Dũng (footballer, born 1963)"@en,
        "Nguyễn Văn Dũng (cầu thủ bóng đá, sinh 1963)"@vi ;
    dbo:abstract "Nguyễn Văn Dũng (sinh ngày 23 tháng 11 năm 1963) là một huấn luyện viên và cựu cầu thủ bóng đá người Việt Nam. Thời còn thi đấu, ông chơi ở vị trí tiền đạo cho đội Nam Định và đội tuyển Việt Nam. Ông là thành viên của đội tuyển Việt Nam tại một số các giải đấu như SEA Games 16 (1991) và Tiger Cup 1998."@vi ;
    dbo:wikiPageExternalLink <http://thethao.thanhnien.com.vn/thethao/pages/200925/20090616000124.aspx>,
        <http://thethao.vnexpress.net/tin-tuc/hau-truong/nguyen-van-dung-tu-cau-thu-den-hlv-854510.html>,
        <http://www.vff.org.vn/vi/lich-su-va-cac-con-so-745/cuu-tuyen-thu-nguyen-van-dung-va-ky-niem-sea-games-16-toi-da-suong-phat-dien-khi-xe-luoi-chu-nha--21144.html>,
        <https://web.archive.org/web/20141006124425/http://thethao.thanhnien.com.vn/thethao/pages/200925/20090616000124.aspx> ;

vres:Võ_Minh_Trí_\(trọng_tài\) a vio:FootballPlayer ;
    rdfs:label "Võ Minh Trí"@en,
        "Võ Minh Trí (trọng tài)"@vi ;
    dbo:abstract """Võ Minh Trí (sinh ngày 3 tháng 4 năm 1972) là cựu trọng tài bóng đá người Việt Nam.
Năm 2001, Võ Minh Trí được công nhận là trọng tài cấp FIFA. Sau đó, ông nhiều lần được FIFA phân công điều khiển các trận đấu thuộc vòng loại World Cup các kỳ 2002, 2006, 2010 và 2014."""@vi ;
    dbo:wikiPageExternalLink <https://www.vff.org.vn/vo-minh-tri-nguoi-dac-biet/> ;
    dbo:wikiPageID 2428933 ;
    dbo:wikiPageLength "2152"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75545829 ;

        vcat:Cầu_thủ_đội_tuyển_bóng_đá_nữ_quốc_gia_Việt_Nam,
        vcat:Người_Hà_Nội,
        vcat:Nhân_vật_còn_sống,
        vcat:Sinh_năm_1974,
        vcat:Tiền_đạo_bóng_đá_nữ ;

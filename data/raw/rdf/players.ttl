vres:Đinh_Hoàng_Max a vio:FootballPlayer ;
    rdfs:label "Đinh Hoàng Max"@en,
        "Đinh Hoàng Max"@vi ;
    dbo:abstract """Đinh Hoàng Max (tên khai sinh là Maxwell Eyerakpo; sinh ngày 14 tháng 12 năm 1986) là một cầu thủ bóng đá người Nigeria nhập quốc tịch Việt Nam chơi ở vị trí tiền vệ.
Trong sự nghiệp, Đinh Hoàng Max từng khoác áo nhiều câu lạc bộ Việt Nam như Hà Nội T&T, Ninh Bình, Hải Phòng, Đồng Tháp, Xuân Thành Sài Gòn, Hùng Vương An Giang, Than Quảng Ninh, XSKT Cần Thơ và Becamex Bình Dương và Topenland Bình Định."""@vi ;
    dbo:wikiPageExternalLink <http://dataframe.tdtt.gov.vn/tabid/55/ArticleID/5317/Default.aspx?returnUrl=/tabid/55/Default.aspx>,
        <http://giadinh.net.vn/home/20090430023219472p0c1004/hai-chang-tay-ho-dinh-hoang-va-loi-goi-calisto.htm>,
        <http://www.sportandsponsor.com/en/players/MAXWELL%20EYERAKPO.pdf>,
        <https://web.archive.org/web/20090504011139/http://giadinh.net.vn/home/20090430023219472p0c1004/hai-chang-tay-ho-dinh-hoang-va-loi-goi-calisto.htm> ;
    dbo:wikiPageID 388228 ;
    dbo:wikiPageLength "7381"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75369597 ;

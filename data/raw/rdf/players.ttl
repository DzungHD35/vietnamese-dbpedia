vres:Phùng_Thị_Minh_Nguyệt a vio:FootballPlayer ;
    rdfs:label "Phùng Thị Minh Nguyệt"@en,
        "Phùng Thị Minh Nguyệt"@vi ;
    dbo:abstract "Phùng Thị Minh Nguyệt (sinh năm 1977 tại Hà Nội) là một cựu nữ cầu thủ bóng đá người Việt Nam. Cùng với đội tuyển bóng đá nữ Việt Nam cô từng giành 2 HCV tại SEA Games 2001 và 2003. Cô được trao danh hiệu \"Cầu thủ xuất sắc nhất\" tại Giải bóng đá nữ vô địch quốc gia 2002 và Quả bóng đồng năm 2003."@vi ;
    dbo:wikiPageID 3289961 ;
    dbo:wikiPageLength "1341"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 74575755 ;
    dct:subject vcat:Cầu_thủ_bóng_đá_nữ_Việt_Nam,

vres:Cần_Thơ a vio:Province ;
    rdfs:label "Cần Thơ"@en,
        "Cần Thơ"@vi ;
    dbo:abstract "Cần Thơ là một trong chín thành phố trực thuộc trung ương thuộc loại Đô thị loại I tại Việt Nam. Đóng vai trò làm trung tâm kinh tế của vùng Đồng bằng sông Cửu Long và còn được mệnh danh là \"Tây Đô\". Sau khi thực hiện sắp xếp đơn vị hành chính năm 2025. Thành phố Cần Thơ hợp nhất với tỉnh Hậu Giang và Sóc Trăng, được chia làm 103 đơn vị hành chính cấp cơ sở, bao gồm 31 phường và 72 xã. Với tổng diện tích khoảng 6.360,83km² và dân số trên 4 triệu người theo thống kê năm 2025. Trung tâm hành chính đặt tại phường Ninh Kiều."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Can_Tho_Bridge.jpg/330px-Can_Tho_Bridge.jpg> ;
    dbo:wikiPageID 1022 ;
    dbo:wikiPageLength "204732"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75607711 ;

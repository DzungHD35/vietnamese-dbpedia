vres:Đắk_Nông_\(tỉnh\) a vio:FormerProvince,
        vio:Province ;
    rdfs:label "Đắk Nông province"@en,
        "Đắk Nông (tỉnh)"@vi ;
    dbo:abstract """Đắk Nông là một tỉnh cũ thuộc vùng Tây Nguyên, miền Trung Việt Nam. Từng tồn tại trong hai giai đoạn: Từ ngày 23 tháng 1 năm 1959 (khi đó mang tên tỉnh Quảng Đức) đến ngày 24 tháng 2 năm 1976 và từ ngày 26 tháng 11 năm 2003 đến ngày 1 tháng 7 năm 2025. Địa phận của tỉnh hiện nay tương ứng với phần phía bắc của tỉnh Lâm Đồng.
Năm 2024, Đắk Nông là tỉnh, thành Việt Nam đông thứ 57 về số dân, xếp thứ 52 về Tổng sản phẩm trên địa bàn (GRDP), xếp thứ 47 về GRDP bình quân đầu người, đứng thứ 7 về tốc độ tăng trưởng GRDP. Với 746.149 người dân, số liệu GRDP đạt 56.807 tỉ Đồng (tương ứng với 2,48 tỷ USD), GRDP bình quân đầu người đạt 76,48 triệu đồng (tương ứng với 3.248 USD), tốc độ tăng trưởng GRDP đạt 8,63%.
Ngày 12 tháng 6 năm 2025, Quốc hội thông qua Nghị quyết số 202/2025/QH15 về việc sắp xếp đơn vị hành chính cấp tỉnh năm 2025, theo đó tỉnh được giải thể cùng tỉnh Bình Thuận để sáp nhập vào tỉnh Lâm Đồng."""@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e4/DraySap400.jpg/330px-DraySap400.jpg> ;
    dbo:wikiPageExternalLink <https://daknong.gov.vn/>,
        <https://web.archive.org/web/20250624111906/https://daknong.gov.vn/> ;

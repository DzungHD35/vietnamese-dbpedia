vres:Hòa_Bình_\(tỉnh\) a vio:FormerProvince,
        vio:Province ;
    rdfs:label "Hòa Bình province"@en,
        "Hòa Bình (tỉnh)"@vi ;
    dbo:abstract """Hòa Bình là một tỉnh miền núi cũ thuộc vùng Tây Bắc Bộ, miền Bắc Việt Nam. Tỉnh tồn tại trong hai giai đoạn: Từ ngày 22 tháng 6 năm 1886 đến ngày 27 tháng 12 năm 1975 và từ ngày 12 tháng 8 năm 1991 đến ngày 1 tháng 7 năm 2025. Địa phận của tỉnh hiện nay tương ứng với phần phía nam của tỉnh Phú Thọ.
Ngày 12 tháng 6 năm 2025, Quốc hội thông qua Nghị quyết số 202/2025/QH15 về việc sắp xếp đơn vị hành chính cấp tỉnh năm  2025, theo đó tỉnh được giải thể cùng với tỉnh Vĩnh Phúc để sáp nhập vào tỉnh Phú Thọ.
Năm 2018, xếp thứ 47 về Tổng sản phẩm trên địa bàn (GRDP), xếp thứ 30 về GRDP bình quân đầu người, đứng thứ 20 về tốc độ tăng trưởng GRDP. Với 846,1 nghìn dân, GRDP đạt 40.867 tỉ Đồng (tương ứng với 1,7749 tỉ USD), GRDP bình quân đầu người đạt 48,3 triệu đồng (tương ứng với 2.098 USD), tốc độ tăng trưởng GRDP đạt 8,36%."""@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Tr%C3%AAn_%C4%91%E1%BA%ADp_th%E1%BB%A7y_%C4%91i%E1%BB%87n_H%C3%B2a_B%C3%ACnh_nh%C3%ACn_to%C3%A0n_c%E1%BA%A3nh_%283%29.jpg/330px-Tr%C3%AAn_%C4%91%E1%BA%ADp_th%E1%BB%A7y_%C4%91i%E1%BB%87n_H%C3%B2a_B%C3%ACnh_nh%C3%ACn_to%C3%A0n_c%E1%BA%A3nh_%283%29.jpg> ;

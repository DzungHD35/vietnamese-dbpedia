vres:Đồng_Nai a vio:Province ;
    rdfs:label "Đồng Nai"@en,
        "Đồng Nai"@vi ;
    dbo:abstract "Đồng Nai là một trong chín thành phố trực thuộc trung ương của Việt Nam, thuộc vùng Đông Nam Bộ, và hiện là thành phố có diện tích lớn nhất Việt Nam. Thành phố được xem là cửa ngõ nối liền giữa vùng Duyên hải Nam Trung Bộ và Tây Nguyên với vùng Đông Nam Bộ. Về mặt hành chính, Đồng Nai được chia thành 95 đơn vị hành chính cấp xã, gồm 33 phường và 62 xã. Trung tâm hành chính - chính trị đặt tại phường Trấn Biên. Đồng Nai hiện là đô thị loại I, là thành phố trung tâm cấp vùng và cấp quốc gia."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Nh%C3%A0_th%E1%BB%9D_ch%C3%ADnh_V%C4%83n_mi%E1%BA%BFu_Tr%E1%BA%A5n_Bi%C3%AAn.jpg/330px-Nh%C3%A0_th%E1%BB%9D_ch%C3%ADnh_V%C4%83n_mi%E1%BA%BFu_Tr%E1%BA%A5n_Bi%C3%AAn.jpg> ;

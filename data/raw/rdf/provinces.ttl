vres:Vĩnh_Phúc_\(tỉnh\) a vio:FormerProvince,
        vio:Province ;
    rdfs:label "Vĩnh Phúc province"@en,
        "Vĩnh Phúc (tỉnh)"@vi ;
    dbo:abstract """Vĩnh Phúc là một tỉnh cũ thuộc vùng Đồng bằng sông Hồng, miền Bắc Việt Nam. Tỉnh tồn tại trong hai giai đoạn: Từ ngày 12 tháng 2 năm 1950 đến ngày 24 tháng 1 năm 1968 và từ ngày 6 tháng 11 năm 1996 đến ngày 1 tháng 7 năm 2025. Đây là tỉnh nằm trong quy hoạch vùng thủ đô Hà Nội, vùng kinh tế trọng điểm Bắc Bộ và là một trong những tỉnh có nền kinh tế phát triển nhất miền Bắc. Địa phận của tỉnh hiện nay tương ứng với phần phía đông bắc của tỉnh Phú Thọ.
Năm 2024, Vĩnh Phúc là đơn vị hành chính Việt Nam đông thứ 37 về số dân, xếp thứ 13 về Tổng sản phẩm trên địa bàn (GRDP), xếp thứ 09 về GRDP bình quân đầu người, đứng thứ 31 về tốc độ tăng trưởng GRDP. Với 1.347.578 người dân, GRDP đạt 152.178 tỉ Đồng (tương ứng với 6,62 tỉ USD), GRDP bình quân đầu người đạt 105 triệu đồng (tương ứng với 5.494 USD), tốc độ tăng trưởng GRDP đạt 8,06%."""@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/L%C3%A2u_%C4%91%C3%A0i_Tam_%C4%90%E1%BA%A3o_-_NKS.jpg/330px-L%C3%A2u_%C4%91%C3%A0i_Tam_%C4%90%E1%BA%A3o_-_NKS.jpg> ;
    dbo:wikiPageExternalLink <http://www.baovinhphuc.vn>,
        <http://www.ipavinhphuc.vn/>,
        <http://www.skhdtvinhphuc.gov.vn>,
        <http://www.vinhphuc.gov.vn/pages/Default.aspx>,
        <http://www.vinhphuctv.vn/front-end/index.php>,
        <https://web.archive.org/web/20090525110748/http://www.baovinhphuc.vn/>,
        <https://web.archive.org/web/20130530162900/http://vinhphuc.gov.vn/pages/Default.aspx>,
        <https://web.archive.org/web/20130606180131/http://www.vinhphuctv.vn/front-end/index.php>,
        <https://web.archive.org/web/20131113091112/http://www.ipavinhphuc.vn/>,
        <https://web.archive.org/web/20161201001157/http://www.skhdtvinhphuc.gov.vn/> ;

vres:Hà_Tây_\(tỉnh\) a vio:FormerProvince,
        vio:Province ;
    rdfs:label "Hà Tây province"@en,
        "Hà Tây (tỉnh)"@vi ;
    dbo:abstract "Hà Tây là một tỉnh cũ thuộc vùng Đồng bằng sông Hồng, miền Bắc Việt Nam. Tỉnh tồn tại trong hai giai đoạn: Ngày 21 tháng 4 năm 1965 đến ngày 27 tháng 12 năm 1975, ngày 12 tháng 8 năm 1991 đến ngày 1 tháng 8 năm 2008. Địa giới của tỉnh tương ứng với khu vực phía tây và phía nam của thành phố Hà Nội ngày nay."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Bi%E1%BB%83u_tr%C6%B0ng_t%E1%BB%89nh_H%C3%A0_T%C3%A2y.png/330px-Bi%E1%BB%83u_tr%C6%B0ng_t%E1%BB%89nh_H%C3%A0_T%C3%A2y.png> ;

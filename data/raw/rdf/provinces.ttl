vres:Chợ_Lớn_\(tỉnh\) a vio:FormerProvince,
        vio:Province ;
    rdfs:label "Chợ Lớn province"@en,
        "Chợ Lớn (tỉnh)"@vi ;
    dbo:abstract "Chợ Lớn là một tỉnh cũ ở Nam Bộ Việt Nam. Tỉnh Chợ Lớn được chính quyền thực dân Pháp thành lập vào ngày 20 tháng 12 năm 1899, chính thức đi vào hoạt động từ ngày 1 tháng 1 năm 1900 và bị mất tên gọi đơn vị hành chính cấp tỉnh kể từ ngày 22 tháng 10 năm 1956 cho đến nay. Và nay thuộc một phần của thành phố Hồ Chí Minh và một phần của tỉnh Tây Ninh."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/Cho_Lon_Province.jpg/330px-Cho_Lon_Province.jpg> ;
    dbo:wikiPageID 85291 ;
    dbo:wikiPageLength "16800"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75586063 ;
    dct:subject <http://vi.dbpedia.org/resource/Thể_loại:Lịch_sử_Sài_Gòn_–_Thành_phố_Hồ_Chí_Minh>,
        vcat:Tỉnh_cũ_Việt_Nam ;
    vio:country vres:Việt_Nam ;
    rdfs:comment "Chợ Lớn là một tỉnh cũ ở Nam Bộ Việt Nam. Tỉnh Chợ Lớn được chính quyền thực dân Pháp thành lập vào ngày 20 tháng 12 năm 1899, chính thức đi vào hoạt động từ ngày 1 tháng 1 năm 1900 và bị mất tên gọi đơn vị hành chính cấp tỉnh kể từ ngày 22 tháng 10 năm 1956 cho đến nay. Và nay thuộc một phần của thành phố Hồ Chí Minh và một phần của tỉnh Tây Ninh."@vi ;

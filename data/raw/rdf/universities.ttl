vres:Học_viện_Khoa_học_Quân_sự a vio:University ;
    rdfs:label "Học viện Khoa học Quân sự"@vi ;
    dbo:abstract """Học viện Khoa học Quân sự (NQH) (tiếng Anh là: Military Science Academy - MSA) là một học viện quân sự trực thuộc Tổng cục II, Bộ Quốc phòng Việt Nam chuyên đào tạo sĩ quan các ngành: tình báo, ngoại ngữ, đối ngoại quân sự, trinh sát kỹ thuật.
Bên cạnh đào tạo sĩ quan ngoại ngữ, học viện còn đào tạo cử nhân ngoại ngữ phục vụ toàn dân trong hệ thống giáo dục của bộ giáo dục ban hành."""@vi ;
    dbo:thumbnail <https://upload.wikimedia.org/wikipedia/vi/1/1a/Hoc-vien-khoa-hoc-quan-su.png> ;
    dbo:wikiPageExternalLink <https://web.archive.org/web/20080307024622/http://www.qdnd.vn/qdnd/baongay.quocphong.tinqpan.30124.qdnd> ;

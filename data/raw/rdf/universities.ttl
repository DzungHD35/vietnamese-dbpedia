vres:Học_viện_Kỹ_thuật_Quân_sự a vio:University ;
    rdfs:label "Le Quy Don Technical University"@en,
        "Học viện Kỹ thuật Quân sự"@vi ;
    dbo:abstract "Học viện Kỹ thuật quân sự (tiếng Anh: Military Technical Academy – MTA, tên dân sự: Trường Đại học Kỹ thuật Lê Quý Đôn) là trường đại học đào tạo kỹ thuật, công nghiệp quốc phòng, công nghệ quân sự trực thuộc Bộ Quốc phòng và chịu sự chỉ đạo nghiệp vụ của Bộ giáo dục và Đào tạo. Học viện có nhiệm vụ đào tạo cán bộ kỹ thuật, công nghệ quân sự, chỉ huy tham mưu kỹ thuật có trình độ đại học, thạc sĩ, tiến sĩ cho quân đội. Đồng thời, Học viện có nhiệm vụ nghiên cứu khoa học công nghệ quân sự, kết hợp nghiên cứu với triển khai ứng dụng, chuyển giao công nghệ với sản xuất và thực hiện nhiệm vụ sẵn sàng chiến đấu và chiến đấu của quân đội."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/vi/thumb/0/0e/Logo_MTA_new.png/330px-Logo_MTA_new.png> ;
    dbo:wikiPageID 41928 ;
    dbo:wikiPageLength "53749"^^xsd:nonNegativeInteger ;
    dbo:wikiPageRevisionID 75614833 ;

vres:Đại_chủng_viện_Thánh_Giuse_Hà_Nội a vio:University ;
    rdfs:label "Đại chủng viện Thánh Giuse Hà Nội"@vi ;
    dbo:abstract "Đại chủng viện Thánh Giuse Hà Nội là một trong số 11 cơ sở đào tạo: 1 học viện, 9 chủng viện (Công giáo) và một chủng viện cơ sở II tại Việt Nam. Chủng viện đào tạo linh mục cho 8 giáo phận miền Bắc Việt Nam. Hiện nay Đại chủng viện Thánh Giuse Hà Nội nằm ở 13 đường Chế Lan Viên, phường Đông Ngạc, thành phố Hà Nội. Giám đốc Đại chủng viện hiện nay là Linh mục Antôn Nguyễn Văn Thắng, Phó Giám đốc là Linh mục Giuse Nguyễn Văn Diễm"@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/%C4%90%E1%BA%A1i_ch%E1%BB%A7ng_vi%E1%BB%87n_th%C3%A1nh_giuse_H%C3%A0_N%E1%BB%99i.JPG/330px-%C4%90%E1%BA%A1i_ch%E1%BB%A7ng_vi%E1%BB%87n_th%C3%A1nh_giuse_H%C3%A0_N%E1%BB%99i.JPG> ;

vres:Đại_chủng_viện_Thánh_Giuse_Xuân_Lộc a vio:University ;
    rdfs:label "Đại chủng viện Thánh Giuse Xuân Lộc"@vi ;
    dbo:abstract "Đại chủng viện Thánh Giuse Xuân Lộc (tiếng Anh: Saint Joseph Seminary of Xuan Loc), một trong 10 đại chủng viện tại Việt Nam, là nơi đào tạo linh mục cho bốn giáo phận: Bà Rịa, Đà Lạt, Phan Thiết và Xuân Lộc của Giáo hội Công giáo tại Việt Nam. Đại chủng viện tọa lạc tại phường Long Khánh, thành phố Đồng Nai, thuộc Giáo phận Xuân Lộc."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/e/eb/Xuan_Loc_Major_Seminary.jpg/330px-Xuan_Loc_Major_Seminary.jpg> ;

vres:Trường_Đại_học_Công_nghệ_Kỹ_thuật_Thành_phố_Hồ_Chí_Minh a vio:University ;
    rdfs:label "Ho Chi Minh City University of Technology and Engineering"@en,
        "Trường Đại học Công nghệ Kỹ thuật Thành phố Hồ Chí Minh"@vi ;
    dbo:abstract """Trường Đại học Công nghệ Kỹ thuật Thành phố Hồ Chí Minh tiếng Anh: Ho Chi Minh City University of Technology and Engineering, viết tắt HCM-UTE (Tên cũ: Trường Đại học Sư phạm Kỹ thuật Thành phố Hồ Chí Minh) là một trường đại học đa ngành tại Việt Nam, với thế mạnh về đào tạo kỹ thuật, được đánh giá là một trong những trường hàng đầu 
về đào tạo khối ngành kỹ thuật tại miền Nam.
Trường là một trong 6 Đại học Sư phạm Kỹ thuật của cả nước – đào tạo kỹ thuật lấy ứng dụng làm trọng tâm để giảng dạy, có chức năng đào tạo kỹ sư công nghệ và giáo viên kỹ thuật. Đồng thời cũng là trung tâm nghiên cứu khoa học và chuyển giao công nghệ của miền Nam Việt Nam."""@vi ;
    dbo:thumbnail <https://upload.wikimedia.org/wikipedia/commons/e/e9/Logo_Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_H%E1%BB%8Dc_C%C3%B4ng_ngh%E1%BB%87_K%E1%BB%B9_Thu%E1%BA%ADt_TP_H%E1%BB%93_Ch%C3%AD_Minh.png> ;

vres:Trường_Đại_học_FPT a vio:University ;
    rdfs:label "FPT University"@en,
        "Trường Đại học FPT"@vi ;
    dbo:abstract "Trường Đại học FPT là một cơ sở giáo dục tại Việt Nam được thành lập ngày 8/9/2006 theo Quyết định số 208/2006/QĐ-TTg của Thủ tướng Chính phủ, do Tập đoàn FPT đầu tư 100% vốn, trở thành trường đại học đầu tiên do doanh nghiệp thành lập tại Việt Nam."@vi ;

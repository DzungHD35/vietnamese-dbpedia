vres:Trường_Đại_học_Lạc_Hồng a vio:University ;
    rdfs:label "Lạc Hồng University"@en,
        "Trường Đại học Lạc Hồng"@vi ;
    dbo:abstract "Trường Đại học Lạc Hồng là một trường đại học tư thục nằm tại thành phố Đồng Nai, Việt Nam. Trường có trụ sở tại số 10 Huỳnh Văn Nghệ, phường Trấn Biên, thành phố Đồng Nai. Được thành lập vào ngày 24 tháng 9 năm 1997, trường đào tạo nhiều khối ngành như kỹ thuật, xã hội, kinh tế và sức khỏe, cùng với các chương trình đào tạo ở trình độ thạc sĩ và tiến sĩ. Trường Đại học Lạc Hồng nổi tiếng với 11 chức vô địch Robocon Việt Nam cũng như là ba lần vô địch cuộc thi ABU Robocon tính đến năm 2026."@vi ;

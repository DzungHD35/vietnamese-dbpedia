vres:Trường_Đại_học_Hàng_hải_Việt_Nam a vio:University ;
    rdfs:label "Vietnam Maritime University"@en,
        "Trường Đại học Hàng hải Việt Nam"@vi ;
    dbo:abstract """Trường Đại học Hàng hải Việt Nam (tiếng Anh: Vietnam Maritime University – VMU) là một đơn vị giáo dục trực thuộc Bộ Xây Dựng, chuyên đào tạo về kỹ thuật, với thế mạnh về đào tạo nhóm ngành hàng hải và logistics được xếp vào nhóm trường đại học trọng điểm quốc gia.
Trường Đại học Hàng hải Việt Nam hiện đang là thành viên của Hiệp hội các trường Đại học Hàng hải châu Á - Thái Bình Dương (AMETIAP) và Hiệp hội các trường Đại học Hàng hải Quốc tế (AMU)."""@vi ;

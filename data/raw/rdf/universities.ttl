vres:Trường_Đại_học_Hải_Phòng a vio:University ;
    rdfs:label "Haiphong University"@en,
        "Trường Đại học Hải Phòng"@vi ;
    dbo:abstract "Trường Đại học Hải Phòng (tiếng Anh: Haiphong University), được thành lập tại Hải Phòng năm 1959 với tên cũ là Phân hiệu Trường Đại học Tại chức Hải Phòng. Năm 2000, Trường Đại học Tại chức Hải Phòng sáp nhập với một số cơ sở đào tạo chuyên nghiệp khác của Hải Phòng thành Trường Đại học Sư phạm Hải Phòng. Ngày 9 tháng 4 năm 2004, Thủ tướng chính phủ đã ký quyết định số 60/2004/QĐ-TTg, đổi tên Trường Đại học Sư phạm Hải Phòng thành Trường Đại học Hải Phòng."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/vi/thumb/c/c7/DHHP.png/330px-DHHP.png> ;

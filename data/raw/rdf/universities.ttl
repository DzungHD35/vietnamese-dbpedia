vres:Trường_Cao_đẳng_Công_nghệ_và_Thương_mại_Hà_Nội a vio:University ;
    rdfs:label "Hanoi College of Technology and Trading"@en,
        "Trường Cao đẳng Công nghệ và Thương mại Hà Nội"@vi ;
    dbo:abstract """Trường Cao đẳng Công nghệ và Thương mại Hà Nội được thành lập vào năm 2007 theo Quyết định số 7273/QĐ-BGDĐT ngày 13/11/2007 của Bộ trưởng Bộ Giáo dục và Đào tạo. Trường có trụ sở chính tại thành phố Hà Nội.
Trường hiện đang đào tạo 29 ngành, nghề hệ cao đẳng và trên 20 ngành nghề hệ Trung cấp. Đã có trên 20.000 sinh viên tốt nghiệp ngôi trường này. Trường được xây dựng trên diện tích hơn 5ha tại thành phố Hà Nội."""@vi ;

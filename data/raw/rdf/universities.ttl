vres:Trường_Đại_học_Nông_Lâm_Thành_phố_Hồ_Chí_Minh a vio:University ;
    rdfs:label "Ho Chi Minh City University of Agriculture and Forestry"@en,
        "Trường Đại học Nông Lâm Thành phố Hồ Chí Minh"@vi ;
    dbo:abstract "Trường Đại học Nông Lâm Thành phố Hồ Chí Minh (tiếng Anh: Ho Chi Minh City University of Agriculture and Forestry (HCMUAF) hoặc Nong Lam University, viết tắt NLU) là một trường đại học đa ngành tại Việt Nam, chuyên đào tạo và nghiên cứu nhóm ngành nông – lâm – ngư nghiệp. Trường trực thuộc Bộ Giáo dục và Đào tạo thành lập trên cơ sở Trường Quốc gia Nông Lâm Mục Bảo Lộc được thành lập từ năm 1955. Trong quá trình phát triển, trường từng là thành viên trong hệ thống Đại học Quốc gia nhưng sau đó được tách ra cho đến ngày nay."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/vi/thumb/e/e1/Logo_HCMUAF.svg/330px-Logo_HCMUAF.svg.png> ;
    dbo:wikiPageExternalLink <http://www.hcmuaf.edu.vn/nlu/>,
        <https://www.facebook.com/NongLamUniversity> ;

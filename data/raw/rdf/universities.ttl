vres:Học_viện_Lục_quân_\(Việt_Nam\) a vio:University ;
    rdfs:label "Học viện Lục quân (Việt Nam)"@vi ;
    dbo:abstract "Học viện Lục quân (tên tiếng Anh: The Army Academy - TAA) trực thuộc Bộ Quốc phòng Việt Nam là nơi chuyên đào tạo sĩ quan chỉ huy tham mưu cấp trung đoàn, sư đoàn lục quân và chiến dịch quân sự cho các binh chủng như Tăng – Thiết giáp, Pháo binh, Công binh, Thông tin Liên lạc, Hóa học, Trinh sát, Phòng không Lục quân, cơ quan và đơn vị thuộc Binh chủng hợp thành. Học viện được thành lập ngày 7 tháng 7 năm 1946. Trụ sở chính của Học viện đóng quân tại Lâm Viên - Lâm Đồng."@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Ph%C3%B9_hi%E1%BB%87u_H%E1%BB%8Dc_Vi%E1%BB%87n_L%E1%BB%A5c_Qu%C3%A2n.png/330px-Ph%C3%B9_hi%E1%BB%87u_H%E1%BB%8Dc_Vi%E1%BB%87n_L%E1%BB%A5c_Qu%C3%A2n.png> ;

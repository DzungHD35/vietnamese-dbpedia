vres:Trường_Đại_học_Hà_Tĩnh a vio:University ;
    rdfs:label "Trường Đại học Hà Tĩnh"@vi ;
    dbo:abstract """Trường Đại học Hà Tĩnh (tên giao dịch quốc tế là Ha Tinh University) là một trường đại học địa phương, một trư­ờng công lập, đa cấp, đa ngành, đào tạo nguồn nhân lực nhằm đáp ứng các yêu cầu của sự nghiệp phát triển kinh tế - xã hội của đất nư­ớc nói chung và tỉnh Hà Tĩnh nói riêng. Năm 2023, bắt đầu xây dựng đề án chuyển đổi cơ chế hoạt động Trường Đại học Hà Tĩnh trở thành trường đại học thành viên của Đại học Quốc gia Hà Nội.
Trường được Thủ tướng Chính phủ quyết định thành lập vào ngày 19 tháng 3 năm 2007, trên cơ sở nâng cấp trường Cao đẳng Sư phạm Hà Tĩnh tại thị xã Hà Tĩnh, tỉnh Hà Tĩnh (nay là phường Thành Sen, tỉnh Hà Tĩnh)"""@vi ;
    dbo:thumbnail <https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_H%C3%A0_T%C4%A9nh%2C_c%C6%A1_s%E1%BB%9F_I.jpeg/330px-Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_H%C3%A0_T%C4%A9nh%2C_c%C6%A1_s%E1%BB%9F_I.jpeg> ;

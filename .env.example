# Copy thành .env rồi điền key. Chỉ cần cho tab "Hỏi đáp (KG-RAG)"; tab SPARQL chạy không cần key.
OPENAI_API_KEY=
# Tùy chọn, mặc định gpt-5.5
OPENAI_MODEL=gpt-5.5

# Dùng nhà cung cấp khác có API tương thích OpenAI: bỏ dấu # ở MỘT nhóm dưới đây,
# điền key của nhà cung cấp đó vào OPENAI_API_KEY ở trên.
#
# Google Gemini (key tại aistudio.google.com):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
#
# Groq (key tại console.groq.com):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Ollama chạy trên máy (OPENAI_API_KEY=ollama):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
